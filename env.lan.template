# KVK LAN template (same local network)
# Copy this file to .env beside KVKSystem.exe on each client laptop

DB_HOST=REPLACE_WITH_SERVER_LAN_IP
DB_PORT=5432
DB_NAME=kvk
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_SSLMODE=prefer
APP_ENV=production

PG_BIN_DIR=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Notes:
# 1) Replace DB_HOST with the DB server LAN IP (example: 192.168.1.50)
# 2) Ensure PostgreSQL listen_addresses includes server IP
# 3) Ensure firewall allows 5432 only for trusted LAN devices
