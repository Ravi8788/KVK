# KVK System - Remote Machine .env Template
# Copy this file to the same folder as KVKSystem.exe on remote machines
# For machines 350 KM away connecting via internet

# Database Configuration (Use localhost - SSH tunnel handles the connection)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kvk
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_SSLMODE=require
APP_ENV=production

# PostgreSQL Binary Directory (Leave empty on remote machines)
PG_BIN_DIR=

# Admin Default Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

