# Secure any-desktop template (Tailscale-based)
# Place this as .env beside KVKSystem.exe on remote desktops

DB_HOST=100.100.100.100
DB_PORT=5432
DB_NAME=kvk
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_SSLMODE=require
APP_ENV=production

PG_BIN_DIR=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Notes:
# 1) Replace DB_HOST with host machine Tailscale IP (100.x.x.x)
# 2) Do NOT use public IP here
# 3) Keep PostgreSQL port 5432 closed on public internet
